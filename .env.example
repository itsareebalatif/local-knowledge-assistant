# Copy this file to .env and fill in real values. Never commit .env.

# --- App ---
APP_ENV=development          # development | production
LOG_LEVEL=INFO

# --- Database (SQLite for metadata/user/graph-edge tables) ---
DATABASE_URL=sqlite:///./data/pke.sqlite3

# --- Vector store ---
VECTOR_STORE_BACKEND=chroma       # chroma | faiss
VECTOR_STORE_PATH=./data/chroma

# --- Graph store ---
GRAPH_STORE_PATH=./data/graph.gpickle

# --- Local LLM (Ollama) ---
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b
EMBEDDING_MODEL=nomic-embed-text

# --- Optional cloud LLM fallback (leave blank to stay fully local) ---
GROQ_API_KEY=
GEMINI_API_KEY=

# --- Chunking ---
CHUNK_TOKEN_SIZE=512
