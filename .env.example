# Copy this file to .env and fill in real values. Never commit .env.

# --- App ---
APP_ENV=development          # development | production
LOG_LEVEL=INFO

# --- Database (SQLite for metadata/user/graph-edge tables) ---
DATABASE_URL=sqlite:///./data/pke.sqlite3

# --- Vector store ---
VECTOR_STORE_BACKEND=chroma       # chroma | faiss
VECTOR_STORE_PATH=./data/chroma
VECTOR_STORE_COLLECTION=chunks

# --- Graph store ---
GRAPH_STORE_PATH=./data/graph.gpickle

# --- Local LLM (Ollama) ---
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b            # or llama3.2:3b, phi3.5, etc. — whatever you `ollama pull`
OLLAMA_TIMEOUT_SECONDS=60
EMBEDDING_MODEL=nomic-embed-text

# --- Optional cloud LLM fallback (leave blank to stay fully local) ---
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-20b     # check what your key can actually use: curl https://api.groq.com/openai/v1/models -H "Authorization: Bearer $GROQ_API_KEY"
GROQ_TIMEOUT_SECONDS=60

# --- Optional cloud LLM: Google AI Studio (Gemini), free tier available ---
# Get a key at https://aistudio.google.com/apikey — no credit card needed.
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_MODEL=gemini-3.8-flash      # gemini-2.0-flash/2.5-flash have been retired by Google
GEMINI_TIMEOUT_SECONDS=60

# --- Generation (Pipeline 2) ---
LLM_BACKEND=local                  # local (Ollama) | groq | gemini
# Overrides LLM_BACKEND for the context-precision evaluation judge only
# (kengine evaluate-context-precision) — leave blank to just use LLM_BACKEND
# for judging too. Useful for keeping live queries on Groq/Ollama while
# judging on Gemini's higher free-tier rate limits.
EVAL_LLM_BACKEND=
MIN_SENTENCE_GROUNDING_COVERAGE=0.3

# --- Embeddings backend (opt-in cloud alternative to Ollama) ---
EMBEDDING_BACKEND=ollama            # ollama (local) | cohere
COHERE_API_KEY=
COHERE_BASE_URL=https://api.cohere.com/v2
COHERE_EMBED_MODEL=embed-english-v3.0
COHERE_TIMEOUT_SECONDS=60

# --- Auth: token lifetimes ---
ACCESS_TOKEN_EXPIRE_MINUTES=60      # short-lived, sent on every request
REFRESH_TOKEN_EXPIRE_DAYS=30        # long-lived, sent only to /api/auth/refresh

# --- Chunking ---
CHUNK_TOKEN_SIZE=512

# --- Retrieval: per-source candidate counts (before fusion) ---
BM25_TOP_K=5
VECTOR_TOP_K=5
GRAPH_TOP_K=5

# --- Retrieval: Reciprocal Rank Fusion ---
RRF_K=60
RRF_TOP_N=10

# --- Retrieval: Reranking (free, local cross-encoder — no API key needed) ---
RERANK_ENABLED=true
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANK_TOP_K=5

# --- Retrieval: MMR (final diversity-aware selection, replaces plain top-k) ---
MMR_ENABLED=true
MMR_TOP_K=5
MMR_LAMBDA=0.5          # 1.0 = pure relevance, 0.0 = pure diversity

# --- Retrieval: Context Sufficiency / Grounding Gate (not yet tuned) ---
MIN_RETRIEVAL_SCORE=0.25
MIN_KEYWORD_COVERAGE=0.4
MIN_GROUNDING_CANDIDATES=1
